# Template de chaves. Não copie valores de production/preprod para este arquivo.
#
# Fonte dos valores: Railway CLI, serviço `domus-api`, environment `local` ou `development`.
#
#   railway link --project <projeto> --environment local --service domus-api
#   railway variable list --service domus-api --environment local --kv > .env
#
# Postgres local (Docker) sobrescreve o DATABASE_URL puxado do Railway:
# copie `.env.local.example` para `.env.local`.
#
# Alternativa sem gravar .env:
#   railway run --service domus-api --environment local -- dotnet run --project src/Domus.Api

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:3001

Authentication__Authority=
Authentication__Audience=

# Preferido no Railway. Localmente, use `.env.local` apontando para o Compose.
DATABASE_URL=
# ConnectionStrings__Database=

# Cors__Origins__0=

DevelopmentSeed__LogtoEndpoint=
DevelopmentSeed__ManagementApiResource=
DevelopmentSeed__ClientId=
DevelopmentSeed__ClientSecret=
