# Copie para .env na raiz do repositório. A API carrega esse arquivo no startup.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:3001

# Logto OIDC (JWT validation — no Management API calls)
# Issuer / authority (must match token `iss`)
Authentication__Authority=https://auth.domus.dev/oidc

# API resource indicator / audience (must match token `aud`)
Authentication__Audience=

# Traditional Web app (cookie BFF, Logto MVC SDK). Endpoint MUST end with a trailing slash.
# Do not use Authentication__Authority (…/oidc) here.
# Local: https://auth.domus.dev/
# Console: Redirect URI https://web.domus.dev/Callback
#          Post sign-out https://web.domus.dev/SignedOutCallback
Logto__Endpoint=https://auth.domus.dev/
Logto__AppId=
Logto__AppSecret=

# PostgreSQL on Railway — either form works:
# ConnectionStrings__Database=Host=...;Port=5432;Database=...;Username=...;Password=...;SSL Mode=Require
# or Railway-style URL:
DATABASE_URL=

# CORS: origem pública do SPA (não use DNS interno / *.railway.internal)
# Local (Caddy): https://web.domus.dev
# Railway: https://${{domus-front.RAILWAY_PUBLIC_DOMAIN}}
# Cors__Origins__0=https://web.domus.dev

# Logto Management API (M2M). Usado por:
#   dotnet run --project src/Domus.Api -- --seed
DevelopmentSeed__LogtoEndpoint=http://host.docker.internal:3001
DevelopmentSeed__ManagementApiResource=https://default.logto.app/api
DevelopmentSeed__ClientId=
DevelopmentSeed__ClientSecret=

# Resend (transactional invitation email). Empty API key logs the email in Development.
Resend__ApiKey=
Resend__From=Domus <noreply@danrantino.dev>
Invitations__FrontendOrigin=https://web.domus.dev
