# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:3001

# Logto OIDC (JWT validation — no Management API calls)
# Issuer / authority (must match token `iss`)
Authentication__Authority=https://logto-auth-preprod.up.railway.app/oidc

# API resource indicator / audience (must match token `aud` and front VITE_LOGTO_API_RESOURCE)
Authentication__Audience=

# PostgreSQL on Railway — either form works:
# ConnectionStrings__Database=Host=...;Port=5432;Database=...;Username=...;Password=...;SSL Mode=Require
# or Railway-style URL:
DATABASE_URL=

# Optional CORS override (default includes http://localhost:3000)
# Cors__Origins__0=http://localhost:3000
