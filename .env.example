# Perfil LOCAL. Copie para `.env` na raiz (git ignora `.env`).
# A API carrega esse arquivo no startup. Variáveis já definidas no processo não são sobrescritas.
#
# Não cole aqui valores de Railway preprod/prod (DATABASE_URL, AppSecret, audience, M2M).
# Railway Development é o environment `preprod` do serviço `domus-back`: as mesmas chaves,
# valores só no Railway. Production é o environment `prod`. Ver README, "Perfis de ambiente".

ASPNETCORE_ENVIRONMENT=Development
# Fora do Dev Container. No Dev Container, PORT=5000 (https://api.domus.dev) tem precedência.
ASPNETCORE_URLS=http://localhost:3001

# Logto OIDC (JWT validation — no Management API calls)
# Issuer / authority (must match token `iss`)
Authentication__Authority=https://auth.domus.dev/oidc

# API resource indicator / audience (must match token `aud`)
Authentication__Audience=

# Traditional Web app (cookie BFF, Logto MVC SDK). Endpoint MUST end with a trailing slash.
# Do not use Authentication__Authority (…/oidc) here.
# Local: https://auth.domus.dev/
# Console: Redirect URI https://web.domus.dev/Callback
#          Post sign-out https://web.domus.dev/SignedOutCallback
Logto__Endpoint=https://auth.domus.dev/
Logto__AppId=
Logto__AppSecret=

# Postgres local definido em compose.yaml. Suba com: docker compose up -d
# Senha só deste Postgres de desenvolvimento. Não reutilize senha de preprod/prod.
POSTGRES_DB=domus
POSTGRES_USER=domus
POSTGRES_PASSWORD=local-only
DATABASE_URL=postgresql://domus:local-only@127.0.0.1:5432/domus
# ConnectionStrings__Database tem precedência sobre DATABASE_URL. Deixe sem definir no perfil local.

# CORS: origem pública do SPA local (Caddy).
# No Railway, sobrescreva com a origem pública de domus-front (não use *.railway.internal).
Cors__Origins__0=https://web.domus.dev

# Logto Management API (M2M). Usado por:
#   dotnet run --project src/Domus.Api -- --seed
DevelopmentSeed__LogtoEndpoint=http://host.docker.internal:3001
DevelopmentSeed__ManagementApiResource=https://default.logto.app/api
DevelopmentSeed__ClientId=
DevelopmentSeed__ClientSecret=

# Resend (transactional invitation email). Empty API key logs the email in Development.
Resend__ApiKey=
Resend__From=Domus <noreply@danrantino.dev>
Invitations__FrontendOrigin=https://web.domus.dev
